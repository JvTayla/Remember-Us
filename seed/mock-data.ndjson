{"_id": "mock-project-moth-to-a-flame", "_type": "project", "title": "Moth to a Flame", "slug": {"_type": "slug", "current": "moth-to-a-flame"}, "category": {"_type": "reference", "_ref": "mock-cat-animation", "_key": "c"}, "subType": "2D", "shortDescription": "A short film about a moth who is sure the moon is a lamp.", "overview": "Moth to a Flame follows one small, stubborn moth on a night-long journey toward the brightest thing she can see.\n\nThe film is fully hand-drawn on paper and scanned, then lightly composited to keep the grain and wobble. We wanted every frame to feel warm and slightly imperfect.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-moth-to-a-flame/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-moth-to-a-flame-1/1200/900", "_key": "g1", "alt": "Moth to a Flame, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-moth-to-a-flame-2/1200/900", "_key": "g2", "alt": "Moth to a Flame, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-moth-to-a-flame-3/1200/900", "_key": "g3", "alt": "Moth to a Flame, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-moth-to-a-flame-4/1200/900", "_key": "g4", "alt": "Moth to a Flame, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-ayanda", "_key": "t0"}, {"_type": "reference", "_ref": "mock-person-liam", "_key": "t1"}], "projectLink": "https://example.com/moth"}
{"_id": "mock-project-clay-tide", "_type": "project", "title": "Clay Tide", "slug": {"_type": "slug", "current": "clay-tide"}, "category": {"_type": "reference", "_ref": "mock-cat-animation", "_key": "c"}, "subType": "Stop Motion", "shortDescription": "Stop motion about a town that rebuilds itself every time the sea takes it.", "overview": "Clay Tide was shot over eleven weeks on a table-sized set, one frame at a time. All characters and buildings are sculpted from clay and reused between shots.\n\nThe project explores memory and repair, and how a place can stay the same while everything in it changes.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-clay-tide/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-clay-tide-1/1200/900", "_key": "g1", "alt": "Clay Tide, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-clay-tide-2/1200/900", "_key": "g2", "alt": "Clay Tide, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-clay-tide-3/1200/900", "_key": "g3", "alt": "Clay Tide, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-clay-tide-4/1200/900", "_key": "g4", "alt": "Clay Tide, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-naledi", "_key": "t0"}], "projectLink": "https://example.com/clay-tide"}
{"_id": "mock-project-loop-line", "_type": "project", "title": "Loop Line", "slug": {"_type": "slug", "current": "loop-line"}, "category": {"_type": "reference", "_ref": "mock-cat-animation", "_key": "c"}, "subType": "3D", "shortDescription": "A looping 3D train journey where every carriage is a different mood.", "overview": "Loop Line is a seamless 3D animation: the camera moves through a train, and each carriage has its own lighting, palette and sound. The last door opens onto the first.\n\nWe built everything procedurally where we could, so changing a single colour script updates the whole film.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-loop-line/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-loop-line-1/1200/900", "_key": "g1", "alt": "Loop Line, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-loop-line-2/1200/900", "_key": "g2", "alt": "Loop Line, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-loop-line-3/1200/900", "_key": "g3", "alt": "Loop Line, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-loop-line-4/1200/900", "_key": "g4", "alt": "Loop Line, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-sam", "_key": "t0"}, {"_type": "reference", "_ref": "mock-person-mei", "_key": "t1"}, {"_type": "reference", "_ref": "mock-person-priya", "_key": "t2"}], "projectLink": "https://example.com/loop-line"}
{"_id": "mock-project-signal-lost", "_type": "project", "title": "Signal Lost", "slug": {"_type": "slug", "current": "signal-lost"}, "category": {"_type": "reference", "_ref": "mock-cat-games", "_key": "c"}, "subType": "Digital (2D/3D)", "shortDescription": "A tense co-op survival game about repairing a failing radio tower.", "overview": "Signal Lost is a three-player co-op game where each player sees only part of the problem and must talk the others through it. Time is short, parts are scarce and the weather keeps getting worse.\n\nWe built the prototype in a engine of our choice, tested with over forty players, and rebuilt the tutorial three times.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-signal-lost/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-signal-lost-1/1200/900", "_key": "g1", "alt": "Signal Lost, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-signal-lost-2/1200/900", "_key": "g2", "alt": "Signal Lost, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-signal-lost-3/1200/900", "_key": "g3", "alt": "Signal Lost, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-signal-lost-4/1200/900", "_key": "g4", "alt": "Signal Lost, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-jordan", "_key": "t0"}, {"_type": "reference", "_ref": "mock-person-fatima", "_key": "t1"}, {"_type": "reference", "_ref": "mock-person-kai", "_key": "t2"}], "projectLink": "https://example.com/signal-lost"}
{"_id": "mock-project-pocket-kingdom", "_type": "project", "title": "Pocket Kingdom", "slug": {"_type": "slug", "current": "pocket-kingdom"}, "category": {"_type": "reference", "_ref": "mock-cat-games", "_key": "c"}, "subType": "Tabletop", "shortDescription": "A 20-minute card game where you rule a kingdom that fits in your pocket.", "overview": "Pocket Kingdom is a two to four player card game about trade, rivalry and clever shortcuts. A full game takes about twenty minutes and the rules fit on a single folded sheet.\n\nThe cards are risograph printed, and the box doubles as the score tracker.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-pocket-kingdom/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-pocket-kingdom-1/1200/900", "_key": "g1", "alt": "Pocket Kingdom, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-pocket-kingdom-2/1200/900", "_key": "g2", "alt": "Pocket Kingdom, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-pocket-kingdom-3/1200/900", "_key": "g3", "alt": "Pocket Kingdom, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-pocket-kingdom-4/1200/900", "_key": "g4", "alt": "Pocket Kingdom, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-chloe", "_key": "t0"}], "projectLink": "https://example.com/pocket-kingdom"}
{"_id": "mock-project-echo-garden", "_type": "project", "title": "Echo Garden", "slug": {"_type": "slug", "current": "echo-garden"}, "category": {"_type": "reference", "_ref": "mock-cat-ai-im", "_key": "c"}, "subType": "Interactive Media", "shortDescription": "An installation where plants respond to your voice with generated sound.", "overview": "Echo Garden is an interactive installation. Visitors speak or hum to a ring of plants, and a model turns their voice into a layered soundscape that grows as the group gets louder.\n\nThe project explores how people behave when a system listens back, and how to make that feel gentle instead of invasive.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-echo-garden/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-echo-garden-1/1200/900", "_key": "g1", "alt": "Echo Garden, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-echo-garden-2/1200/900", "_key": "g2", "alt": "Echo Garden, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-echo-garden-3/1200/900", "_key": "g3", "alt": "Echo Garden, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-echo-garden-4/1200/900", "_key": "g4", "alt": "Echo Garden, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-rohan", "_key": "t0"}, {"_type": "reference", "_ref": "mock-person-emma", "_key": "t1"}, {"_type": "reference", "_ref": "mock-person-ayanda", "_key": "t2"}], "projectLink": "https://example.com/echo-garden"}
{"_id": "mock-project-paper-skyline", "_type": "project", "title": "Paper Skyline", "slug": {"_type": "slug", "current": "paper-skyline"}, "category": {"_type": "reference", "_ref": "mock-cat-visual-design", "_key": "c"}, "subType": "Illustration", "shortDescription": "A fold-out illustrated map of a city that does not exist yet.", "overview": "Paper Skyline is a series of illustrated posters and a fold-out map, drawn in flat shapes and a limited palette. Each district has its own colour, typeface and set of tiny characters.\n\nThe set was printed as a risograph edition of one hundred.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-paper-skyline/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-paper-skyline-1/1200/900", "_key": "g1", "alt": "Paper Skyline, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-paper-skyline-2/1200/900", "_key": "g2", "alt": "Paper Skyline, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-paper-skyline-3/1200/900", "_key": "g3", "alt": "Paper Skyline, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-paper-skyline-4/1200/900", "_key": "g4", "alt": "Paper Skyline, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-tumelo", "_key": "t0"}], "projectLink": "https://example.com/paper-skyline"}
{"_id": "mock-project-an-extraordinarily-long-project-title-th", "_type": "project", "title": "An Extraordinarily Long Project Title That Tests How The Layout Wraps On Small Screens", "slug": {"_type": "slug", "current": "an-extraordinarily-long-project-title-that-tests-how-the-layout-wraps-on-small-screens"}, "category": {"_type": "reference", "_ref": "mock-cat-visual-design", "_key": "c"}, "subType": "Editorial", "shortDescription": "A zine series used here to test very long titles and bios in the layout.", "overview": "This entry is deliberately wordy so you can see how long titles, long names and long paragraphs behave across the category card, the project hero and the team section.\n\nIf this page looks good, the real content will too.", "heroImage": {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/hero-an-extraordinarily-l/1600/1000"}, "gallery": [{"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-an-extraordinar-1/1200/900", "_key": "g1", "alt": "An Extraordinarily Long Project Title That Tests How The Layout Wraps On Small Screens, image 1"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-an-extraordinar-2/1200/900", "_key": "g2", "alt": "An Extraordinarily Long Project Title That Tests How The Layout Wraps On Small Screens, image 2"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-an-extraordinar-3/1200/900", "_key": "g3", "alt": "An Extraordinarily Long Project Title That Tests How The Layout Wraps On Small Screens, image 3"}, {"_type": "image", "_sanityAsset": "image@https://picsum.photos/seed/gal-an-extraordinar-4/1200/900", "_key": "g4", "alt": "An Extraordinarily Long Project Title That Tests How The Layout Wraps On Small Screens, image 4"}], "team": [{"_type": "reference", "_ref": "mock-person-nomvula", "_key": "t0"}]}
